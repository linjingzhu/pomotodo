{
  "name": "pomodoro-timer",
  "version": "1.0.8",
  "description": "Installable Pomodoro timer for Windows",
  "main": "main.js",
  "author": "Daniel Sword",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "test": "node --test \"test/*.test.js\"",
    "icons": "electron scripts/make-icons.js"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.danielsword.pomodorotimer",
    "productName": "Pomodoro Timer",
    "files": [
      "main.js",
      "preload.js",
      "store.js",
      "renderer/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "portable": {
      "artifactName": "PomodoroTimer-Portable-${version}.${ext}"
    }
  }
}
