{
  "name": "pomodoro-timer",
  "version": "0.3.0",
  "description": "Installable Pomodoro timer for Windows",
  "main": "main.js",
  "author": "Daniel Sword",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "test": "node --test \"test/*.test.js\"",
    "icons": "electron scripts/make-icons.js",
    "lint": "eslint .",
    "check": "npm run lint && npm test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "eslint": "10.11.0",
    "globals": "^16.5.0"
  },
  "build": {
    "appId": "com.danielsword.pomodorotimer",
    "productName": "Pomodoro Timer",
    "files": [
      "main.js",
      "preload.js",
      "store.js",
      "toast.js",
      "renderer/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "PomodoroTimer-Portable-${version}.${ext}"
    }
  },
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  }
}
